<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clickable="true" android:focusable="true" android:importantForAccessibility="yes">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:importantForAccessibility="noHideDescendants">
        <ImageView android:id="@+id/widget_logo" android:layout_width="32dp" android:layout_height="32dp"
            android:src="@mipmap/ic_goldberg" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/widget_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="0dp">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_open_studio" android:textSize="15sp" android:fontFamily="@font/inter" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_context" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_unavailable" android:textSize="12sp" android:fontFamily="@font/inter" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="10sp" android:fontFamily="@font/inter" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_compact_status" android:layout_width="20dp" android:layout_height="24dp" android:layout_gravity="bottom|end"
        android:textSize="12sp" android:gravity="center" android:textStyle="bold" android:importantForAccessibility="no" />
</FrameLayout>
