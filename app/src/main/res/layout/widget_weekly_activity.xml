<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clickable="true" android:focusable="true" android:importantForAccessibility="yes">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp" android:layout_marginBottom="32dp" android:importantForAccessibility="noHideDescendants">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_weekly_title" android:textSize="13sp" android:fontFamily="@font/inter" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="—" android:textSize="24sp" android:textStyle="bold" android:fontFamily="@font/inter" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_context" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_unavailable" android:textSize="10sp" android:fontFamily="@font/inter" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:fontFamily="@font/inter" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="8dp"
        android:textSize="10sp" android:fontFamily="@font/inter" android:maxLines="1" android:ellipsize="end" android:importantForAccessibility="no" />
</FrameLayout>
